CfgSaveBtn.MouseButton1Click:Connect(function()
    local name = ConfigNameBox.Text:gsub('^%s*(.-)%s*$', '%1')
    if name ~= "" then
        local cnt = ""
        pcall(function() cnt = readfile(F_PATH) end)
        local activeDec = AutoRepairJSON(cnt)
        
        local cfgCnt = ""
        pcall(function() cfgCnt = readfile(CONFIGS_PATH) end)
        local ok, savedConfigs = pcall(function() return HttpService:JSONDecode(cfgCnt) end)
        if not ok or type(savedConfigs) ~= "table" then
            savedConfigs = {}
        end

        savedConfigs[name] = activeDec
        pcall(function()
            writefile(CONFIGS_PATH, HttpService:JSONEncode(savedConfigs))
        end)
        
        CfgSaveBtn.Text = "Saved!"
        RefreshLists()
        task.delay(1.2, function()
            CfgSaveBtn.Text = "Save Config"
            ClosePanel(SaveConfigPanel)
        end)
    end
end)

