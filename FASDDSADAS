AddBtn.MouseButton1Click:Connect(function()
    local fn = NewName.Text:gsub('^%s*(.-)%s*$', '%1')
    local fv = NewVal.Text:gsub('^%s*(.-)%s*$', '%1')
    if fn ~= "" and fv ~= "" then
        local parsedVal = fv
        if tonumber(fv) then parsedVal = tonumber(fv)
        elseif fv:lower() == "true" then parsedVal = true
        elseif fv:lower() == "false" then parsedVal = false end
        
        local cnt = SafeReadFile(F_PATH)
        local dec = AutoRepairJSON(cnt)
        if type(dec) == "table" then
            dec[fn] = parsedVal
            SafeWriteFile(F_PATH, HttpService:JSONEncode(dec))
            RefreshLists()
            LoadEditPanel(SearchBox.Text)
        end
        NewName.Text = ""
        NewVal.Text = ""
        AddBtn.Text = "Added!"
        task.delay(1, function() AddBtn.Text = "Add" end)
    end
end)

