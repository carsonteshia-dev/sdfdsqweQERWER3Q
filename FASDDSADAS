local function AutoRepairJSON(rawText)
    if type(rawText) ~= "string" or rawText:match("^%s*$") then
        return {}, "{}"
    end

    local ok, parsed = pcall(function() return HttpService:JSONDecode(rawText) end)
    if ok and type(parsed) == "table" then
        return parsed, HttpService:JSONEncode(parsed)
    end

    local result = {}
    local text = rawText
    text = text:gsub("//[^\r\n]*", "")
    text = text:gsub("/%*.-%*/", "")

    for key, val in text:gmatch('["\']?([%w_]+)["\']?%s*[:=]%s*(["\']?[%w_.%-]+["\']?)') do
        local cleanKey = key:gsub('["\']', ''):gsub('^%s*(.-)%s*$', '%1')
        local cleanVal = val:gsub('^%s*(.-)%s*$', '%1')

        if cleanVal:sub(1,1) == '"' or cleanVal:sub(1,1) == "'" then
            cleanVal = cleanVal:sub(2, -2)
        end

        local num = tonumber(cleanVal)
        if num ~= nil then
            result[cleanKey] = num
        elseif cleanVal:lower() == "true" then
            result[cleanKey] = true
        elseif cleanVal:lower() == "false" then
            result[cleanKey] = false
        else
            result[cleanKey] = cleanVal
        end
    end

    local finalJson = "{}"
    pcall(function()
        finalJson = HttpService:JSONEncode(result)
    end)

    return result, finalJson
end

