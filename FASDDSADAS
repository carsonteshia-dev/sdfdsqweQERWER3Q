                local fpsOk = pcall(function()
                    setfpscap(tonumber(val) or 9999)
                end)
                if fpsOk then applied = true end
            end
            
            if applied then
                successCount = successCount + 1
            else
                errorCount = errorCount + 1
            end
        end
        
        StartEngineWithAutoExec()
        return true, successCount, errorCount, nil
    else
        return false, 0, 0, "PARSE_ERROR"
    end
end

