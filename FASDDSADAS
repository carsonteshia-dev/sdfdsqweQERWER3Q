local function LoadEditPanel(srch)
    for _, x in ipairs(EditScroll:GetChildren()) do
        if x:IsA("Frame") then x:Destroy() end
    end
    local cnt = ""
    pcall(function() cnt = readfile(F_PATH) end)
    if cnt and cnt ~= "" then
        local dec = AutoRepairJSON(cnt)
        if type(dec) == "table" then
            for k, v in pairs(dec) do
                if type(k) == "string" and (not srch or srch == "" or k:lower():find(srch:lower())) then
                    local R = Instance.new("Frame")
                    R.Size = UDim2.new(1, -8, 0, 32)
                    R.BackgroundColor3 = C.CBoxBg
                    R.BorderSizePixel = 0
                    R.Parent = EditScroll
                    Instance.new("UICorner", R).CornerRadius = UDim.new(0, 6)

                    local Nm = Instance.new("TextLabel")
                    Nm.Size = UDim2.new(0, 150, 1, 0)
                    Nm.Position = UDim2.new(0, 10, 0, 0)
                    Nm.BackgroundTransparency = 1
                    Nm.Text = k
                    Nm.Font = Enum.Font.Code
                    Nm.TextSize = 11
                    Nm.TextColor3 = C.TxtDark
                    Nm.TextXAlignment = Enum.TextXAlignment.Left
                    Nm.Parent = R

                    local ValBox = Instance.new("TextBox")
                    ValBox.Size = UDim2.new(0, 90, 1, -8)
                    ValBox.Position = UDim2.new(0, 165, 0.5, -12)
                    ValBox.BackgroundColor3 = C.EditorBg
                    ValBox.Text = tostring(v)
                    ValBox.Font = Enum.Font.Code
                    ValBox.TextSize = 11
                    ValBox.TextColor3 = C.TxtDark
                    ValBox.Parent = R
                    Instance.new("UICorner", ValBox).CornerRadius = UDim.new(0, 4)
                    AddStroke(ValBox, {Thickness = 1, Color = C.Border})

                    local Sv = Instance.new("TextButton")
                    Sv.Size = UDim2.new(0, 44, 1, -8)
                    Sv.Position = UDim2.new(1, -98, 0.5, -12)
                    Sv.BackgroundColor3 = C.Blue
                    Sv.BorderSizePixel = 0
                    Sv.Text = "Set"
                    Sv.Font = Enum.Font.GothamBold
                    Sv.TextSize = 11
                    Sv.TextColor3 = C.TxtWhite
                    Sv.Parent = R
                    Instance.new("UICorner", Sv).CornerRadius = UDim.new(0, 4)

                    local Del = Instance.new("TextButton")
                    Del.Size = UDim2.new(0, 44, 1, -8)
                    Del.Position = UDim2.new(1, -48, 0.5, -12)
                    Del.BackgroundColor3 = C.DarkRed
                    Del.BorderSizePixel = 0
                    Del.Text = "Del"
                    Del.Font = Enum.Font.GothamBold
                    Del.TextSize = 11
                    Del.TextColor3 = C.TxtWhite
                    Del.Parent = R
                    Instance.new("UICorner", Del).CornerRadius = UDim.new(0, 4)

                    Sv.MouseButton1Click:Connect(function()
                        local nv = ValBox.Text
                        if tonumber(nv) then nv = tonumber(nv)
                        elseif nv:lower() == "true" then nv = true
                        elseif nv:lower() == "false" then nv = false end
                        local curCnt = ""
                        pcall(function() curCnt = readfile(F_PATH) end)
                        local curDec = AutoRepairJSON(curCnt)
                        if type(curDec) == "table" then
                            curDec[k] = nv
                            pcall(function() writefile(F_PATH, HttpService:JSONEncode(curDec)) end)
                            RefreshLists()
                        end
                    end)

                    Del.MouseButton1Click:Connect(function()
                        local curCnt = ""
                        pcall(function() curCnt = readfile(F_PATH) end)
                        local curDec = AutoRepairJSON(curCnt)
                        if type(curDec) == "table" then
                            curDec[k] = nil
                            pcall(function() writefile(F_PATH, HttpService:JSONEncode(curDec)) end)
                            RefreshLists()
                            R:Destroy()
                        end
                    end)
                end
            end
        end
    end
    EditScroll.CanvasSize = UDim2.new(0, 0, 0, EL.AbsoluteContentSize.Y + 10)
end

