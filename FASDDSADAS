-- Apply Flags Button Execution
InjectBtn.MouseButton1Click:Connect(function()
    local cnt = SafeReadFile(F_PATH)
    local decoded, validJson = AutoRepairJSON(cnt)
    local totalFlags = 0
    if type(decoded) == "table" then
        for _ in pairs(decoded) do totalFlags = totalFlags + 1 end
    end

    SafeWriteFile(F_PATH, validJson)
    _G.ShystxActiveFlagsCache = BuildNormalizedCache(decoded)
    _G.ShystxEngineActive = true

    if type(decoded) == "table" then
        for flagName, val in pairs(decoded) do
            TrySetFlag(flagName, val)
            if flagName:lower():find("targetfps") and type(setfpscap) == "function" then
                pcall(function() setfpscap(tonumber(val) or 9999) end)
            end
        end
    end

    -- Persistent Local Stack Quine Re-Queue
    local rawQ = queue_on_teleport 
              or (syn and type(syn) == "table" and syn.queue_on_teleport) 
              or (fluxus and type(fluxus) == "table" and fluxus.queue_on_teleport) 
              or queueonteleport 
              or queue_for_teleport

    if rawQ then
        pcall(function()
            rawQ(fullSource)
        end)
    end

    InjectBtn.Text = "Applied (" .. tostring(totalFlags) .. ")"
    RefreshLists()
    task.delay(2, function() InjectBtn.Text = "Apply Flags" end)
end)

