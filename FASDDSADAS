local function VerifyFlagStatus(flagName)
    if type(flagName) ~= "string" then return false end
    local getfflag_func = getfflag or getflag
    if type(getfflag_func) ~= "function" and getgenv and type(getgenv) == "function" then
        pcall(function() getfflag_func = getgenv().getfflag end)
    end
    if type(getfflag_func) ~= "function" then return false end
    local s, r = pcall(function()
        local clean = CleanFlagName(flagName)
        local val = getfflag_func(clean)
        if val == nil then val = getfflag_func(flagName) end
        return val ~= nil
    end)
    return (s and r) or false
end

local function TrySetFlag(flagName, val)
    if type(setfflag) ~= "function" then return false end
    local cleanName = CleanFlagName(flagName)
    
    local ok1 = pcall(function() setfflag(flagName, val) end)
    if ok1 then return true end
    local ok2 = pcall(function() setfflag(flagName, tostring(val)) end)
    if ok2 then return true end
    local ok3 = pcall(function() setfflag(cleanName, val) end)
    if ok3 then return true end
    local ok4 = pcall(function() setfflag(cleanName, tostring(val)) end)
    if ok4 then return true end

    return false
end

