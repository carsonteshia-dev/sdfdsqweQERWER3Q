        local curveToUse = hasAdaptiveFlags and enhancedCurve or baseCurve
        for i = 1, #curveToUse do
            if not currentRootPart or not currentRootPart.Parent then break end
            local curVel = GetLinearVel(currentRootPart)
            SetLinearVel(currentRootPart, curVel.X, curVel.Y + curveToUse[i], curVel.Z)
            RunService.Heartbeat:Wait()
        end
        task.wait(0.15)
        isAirborneBoosting = false
    end)
end

local function setupCharacter(char)
    if not char then return end
    cleanupCharacter()

    local humanoid = char:WaitForChild("Humanoid", 5)
    local root = char:WaitForChild("HumanoidRootPart", 5)
    if not humanoid or not root then return end

    currentHumanoid = humanoid
    currentRootPart = root

    pcall(function()
        humanoid.UseJumpPower = true
        humanoid.JumpPower = 50
        humanoid.AutoRotate = true
        humanoid.PlatformStand = false
    end)

    if humanoid:GetState() == Enum.HumanoidStateType.Physics then
        humanoid:ChangeState(Enum.HumanoidStateType.Running)
    end

    local bouncePhase = 0

    table.insert(characterConnections, RunService.Heartbeat:Connect(function()
        if not _G.ShystxEngineActive or not root or not root.Parent or not activeToggle then return end

        local flags = _G.ShystxActiveFlagsCache or {}

        local adaptiveMatches = 0
        if flags["SimAdaptiveTimesteppingDefault2"] then adaptiveMatches = adaptiveMatches + 1 end
        if flags["SimAdaptiveHumanoidPDControllerSubstepMultiplier"] then adaptiveMatches = adaptiveMatches + 1 end
        if flags["SimHumanoidTimestepModelUpdate"] then adaptiveMatches = adaptiveMatches + 1 end
        local hasAdaptiveFlags = (adaptiveMatches >= 1)

        -- Ground Micro-Bounce
        if hasAdaptiveFlags and not isAirborneBoosting then
            local isGrounded = (humanoid.FloorMaterial ~= Enum.Material.Air)
            local state = humanoid:GetState()
            if isGrounded or state == Enum.HumanoidStateType.Running or state == Enum.HumanoidStateType.RunningNoPhysics or state == Enum.HumanoidStateType.Landed then
                bouncePhase = bouncePhase + 1
                if bouncePhase >= 2 then bouncePhase = 0 end
                local vel = GetLinearVel(root)
                if bouncePhase == 0 then
                    SetLinearVel(root, vel.X, -2.5, vel.Z)
                else
                    SetLinearVel(root, vel.X, 5.8, vel.Z)
                end
            end
        end

        -- FF3 Ticked Booster Loop
        if ff3Boosting then
            ff3TickCount = ff3TickCount + 1
            local jitter = (math.random() * 0.2) - 0.1
            local vel = GetLinearVel(root)
            if vel.Y > 0 then
                SetLinearVel(root, vel.X, vel.Y + FF3_BOOST + jitter, vel.Z)
            end

            if ff3TickCount >= FF3_TICKS then
                ff3Boosting = false
                ff3TickCount = 0
            end
        end
    end))

    table.insert(characterConnections, humanoid.StateChanged:Connect(function(_, newState)
        if not _G.ShystxEngineActive then return end
        if newState == Enum.HumanoidStateType.Landed then
            isAirborneBoosting = false
        elseif newState == Enum.HumanoidStateType.Jumping then
            TriggerJumpBoost()
        end
    end))

    table.insert(characterConnections, humanoid.Jumping:Connect(function(isJumping)
        if _G.ShystxEngineActive and isJumping then TriggerJumpBoost() end
    end))
end

table.insert(engineConnections, UserInputService.JumpRequest:Connect(function()
    if _G.ShystxEngineActive then TriggerJumpBoost() end
end))

table.insert(engineConnections, UserInputService.InputBegan:Connect(function(input, _)
    local rawKey = input.KeyCode
    if rawKey == Enum.KeyCode.LeftControl 
        or rawKey == Enum.KeyCode.RightControl 
        or rawKey == Enum.KeyCode.DPadUp then
        activeToggle = not activeToggle
    end
end))

