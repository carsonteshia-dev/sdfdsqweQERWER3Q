local function RefreshLists()
    for _, x in ipairs(FlagScroll:GetChildren()) do if x:IsA("Frame") then x:Destroy() end end
    for _, x in ipairs(ConfigScroll:GetChildren()) do if x:IsA("Frame") then x:Destroy() end end

    local cnt = SafeReadFile(F_PATH)
    if cnt and cnt ~= "" then
        local dec = AutoRepairJSON(cnt)
        if type(dec) == "table" then
            for k, v in pairs(dec) do
                if type(k) == "string" then AddActiveRow(k, v) end
            end
        end
    end

    local cfgCnt = SafeReadFile(CONFIGS_PATH)
    if cfgCnt and cfgCnt ~= "" then
        local ok, dec = pcall(function() return HttpService:JSONDecode(cfgCnt) end)
        if ok and type(dec) == "table" then
            for cfgName, flagsObj in pairs(dec) do
                if type(cfgName) == "string" and type(flagsObj) == "table" then
                    local count = 0
                    for _ in pairs(flagsObj) do count = count + 1 end

                    local R = Instance.new("Frame")
                    R.Size = UDim2.new(1, -8, 0, 32)
                    R.BackgroundColor3 = C.CBoxBg
                    R.BorderSizePixel = 0
                    R.Parent = ConfigScroll
                    Instance.new("UICorner", R).CornerRadius = UDim.new(0, 6)

                    local NameLbl = Instance.new("TextLabel")
                    NameLbl.Size = UDim2.new(1, -170, 1, 0)
                    NameLbl.Position = UDim2.new(0, 12, 0, 0)
                    NameLbl.BackgroundTransparency = 1
                    NameLbl.Text = cfgName .. " (" .. tostring(count) .. " flags)"
                    NameLbl.Font = Enum.Font.GothamBold
                    NameLbl.TextSize = 11
                    NameLbl.TextColor3 = C.TxtDark
                    NameLbl.TextXAlignment = Enum.TextXAlignment.Left
                    NameLbl.Parent = R

                    local LoadBtn = Instance.new("TextButton")
                    LoadBtn.Size = UDim2.new(0, 50, 0, 22)
                    LoadBtn.Position = UDim2.new(1, -112, 0.5, -11)
                    LoadBtn.BackgroundColor3 = C.Blue
                    LoadBtn.BorderSizePixel = 0
                    LoadBtn.Text = "Load"
                    LoadBtn.Font = Enum.Font.GothamBold
                    LoadBtn.TextSize = 10
                    LoadBtn.TextColor3 = C.TxtWhite
                    LoadBtn.Parent = R
                    Instance.new("UICorner", LoadBtn).CornerRadius = UDim.new(0, 4)

                    local DelBtn = Instance.new("TextButton")
                    DelBtn.Size = UDim2.new(0, 50, 0, 22)
                    DelBtn.Position = UDim2.new(1, -56, 0.5, -11)
                    DelBtn.BackgroundColor3 = C.BtnBg
                    DelBtn.BorderSizePixel = 0
                    DelBtn.Text = "Delete"
                    DelBtn.Font = Enum.Font.GothamMedium
                    DelBtn.TextSize = 10
                    DelBtn.TextColor3 = C.Red
                    DelBtn.Parent = R
                    Instance.new("UICorner", DelBtn).CornerRadius = UDim.new(0, 4)

                    LoadBtn.MouseButton1Click:Connect(function()
                        SafeWriteFile(F_PATH, HttpService:JSONEncode(flagsObj))
                        LoadBtn.Text = "Loaded"
                        task.delay(1.5, function() LoadBtn.Text = "Load" end)
                        RefreshLists()
                    end)

                    DelBtn.MouseButton1Click:Connect(function()
                        dec[cfgName] = nil
                        SafeWriteFile(CONFIGS_PATH, HttpService:JSONEncode(dec))
                        R:Destroy()
                    end)
                end
            end
        end
    end

    FlagScroll.CanvasSize = UDim2.new(0, 0, 0, FLayout.AbsoluteContentSize.Y + 10)
    ConfigScroll.CanvasSize = UDim2.new(0, 0, 0, CLayout.AbsoluteContentSize.Y + 10)
end

